#!/data/data/com.termux/files/usr/bin/bash

VERSION="1.0.4"
REPO="https://raw.githubusercontent.com/krezer1422-netizen/qrtext/main/qrtext"

# O'rnatish rejimi
if [ "${0##*/}" = "bash" ]; then

    if [ -z "$PREFIX" ]; then
        echo "Faqat Termux qo'llab-quvvatlanadi."
        exit 1
    fi

    echo "QRText v$VERSION o'rnatilmoqda..."

    pkg install python -y >/dev/null 2>&1 || exit 1
    python -m pip install --quiet qrcode || exit 1

    mkdir -p "$PREFIX/bin" || exit 1

    TMP="$PREFIX/bin/qrtext.tmp"

    curl -fsSL "$REPO" -o "$TMP" || {
        rm -f "$TMP"
        exit 1
    }

    chmod +x "$TMP"
    mv "$TMP" "$PREFIX/bin/qrtext" || exit 1

    echo "QRText v$VERSION muvaffaqiyatli o'rnatildi!"

    cat <<'BANNER'
  /$$$$$$         /$$$$$$$$ /$$$$$$$$ /$$   /$$ /$$$$$$$$
 /$$__  $$       |__  $$__/| $$_____/| $$  / $$|__  $$__/
| $$  \ $$  /$$$$$$ | $$   | $$      |  $$/ $$/   | $$
| $$  | $$ /$$__  $$| $$   | $$$$$    \  $$$$/    | $$
| $$  | $$| $$  \__/| $$   | $$__/     >$$  $$    | $$
| $$/$$ $$| $$      | $$   | $$       /$$/\  $$   | $$
|  $$$$$$/| $$      | $$   | $$$$$$$$| $$  \ $$   | $$
 \____ $$$|__/      |__/   |________/|__/  |__/   |__/
      \__/
BANNER

    exit 0
fi

# Versiya
if [ "$1" = "-v" ]; then
    echo "$VERSION"
    exit 0
fi

# Yordam
if [ "$1" = "-h" ]; then
    echo "QRText v$VERSION"
    echo "Usage: qrtext <text>"
    echo "       qrtext -v"
    echo "       qrtext -h"
    exit 0
fi

# QR generator
exec python - "$@" <<'PY'
import sys
import qrcode

text = " ".join(sys.argv[1:])

if not text:
    text = input()

qr = qrcode.QRCode(border=1)
qr.add_data(text)
qr.make(fit=True)

matrix = qr.get_matrix()

for y in range(0, len(matrix), 2):
    top = matrix[y]
    bottom = matrix[y+1] if y+1 < len(matrix) else [False] * len(top)

    print("".join(
        "█" if a and b else
        "▀" if a else
        "▄" if b else " "
        for a, b in zip(top, bottom)
    ))
PY
