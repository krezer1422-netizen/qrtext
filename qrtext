#!/data/data/com.termux/files/usr/bin/bash

VERSION="1.0.5"
REPO="https://raw.githubusercontent.com/krezer1422-netizen/qrtext/main/qrtext"

# O'rnatish rejimi
if [ "${0##*/}" = "bash" ]; then

    if [ -z "$PREFIX" ]; then
        echo "Faqat Termux qo'llab-quvvatlanadi."
        exit 1
    fi

    pkg install python -y >/dev/null 2>&1 || exit 1
    python -m pip install --quiet qrcode || exit 1

    mkdir -p "$PREFIX/bin" || exit 1

    TMP="$PREFIX/bin/qrtext.tmp"

    curl -fsSL "$REPO" -o "$TMP" || {
        rm -f "$TMP"
        exit 1
    }

    chmod +x "$TMP"
    mv "$TMP" "$PREFIX/bin/qrtext" || exit 1

    clear

    cat <<'BANNER'
                      d8P                     d8P
                   d888888P                d888888P
.d88b,.88P  88bd88b  ?88'   d8888b?88,  88P  ?88'
88P  `88P'  88P'  `  88P   d8b_,dP `?8bd8P'  88P
?8b  d88   d88       88b   88b     d8P?8b,   88b
`?888888  d88'       `?8b  `?888P'd8P' `?8b  `?8b
    `?88
      88b
      ?8P
BANNER

    exit 0
fi

# Versiya
if [ "$1" = "-v" ]; then
    echo "$VERSION"
    exit 0
fi

# Yordam
if [ "$1" = "-h" ]; then
    echo "QRText v$VERSION"
    echo "Usage: qrtext <text>"
    echo "       qrtext -v"
    echo "       qrtext -h"
    exit 0
fi

# QR generator
exec python - "$@" <<'PY'
import sys
import qrcode

text = " ".join(sys.argv[1:])

if not text:
    try:
        text = input()
    except EOFError:
        sys.exit(0)

qr = qrcode.QRCode(border=1)
qr.add_data(text)
qr.make(fit=True)

matrix = qr.get_matrix()

for y in range(0, len(matrix), 2):
    top = matrix[y]
    bottom = matrix[y+1] if y+1 < len(matrix) else [False] * len(top)

    print("".join(
        "█" if a and b else
        "▀" if a else
        "▄" if b else " "
        for a, b in zip(top, bottom)
    ))
PY
