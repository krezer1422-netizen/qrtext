#!/data/data/com.termux/files/usr/bin/python

import sys
import qrcode

VERSION = "1.0.3"

args = sys.argv[1:]

if args == ["-v"]:
    print(VERSION)
    sys.exit(0)

if args == ["-h"]:
    print("QRText v" + VERSION)
    print("Usage: qrtext <text> | -v | -h")
    sys.exit(0)

text = " ".join(args)

if not text:
    text = input()

qr = qrcode.QRCode(border=1)
qr.add_data(text)
qr.make(fit=True)

matrix = qr.get_matrix()

for y in range(0, len(matrix), 2):
    top = matrix[y]
    bottom = matrix[y+1] if y+1 < len(matrix) else [False] * len(top)

    print("".join(
        "█" if a and b else
        "▀" if a else
        "▄" if b else " "
        for a, b in zip(top, bottom)
    ))
